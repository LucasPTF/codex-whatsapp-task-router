{
  "name": "codex-whatsapp-task-router",
  "version": "0.1.0",
  "description": "Local-first WhatsApp conversation triage and task routing with human-reviewed Codex analysis.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucasPTF/codex-whatsapp-task-router.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.14 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node apps/server/src/main.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm run verify:skills && npm test && npm run build",
    "desktop": "electron apps/desktop/main.cjs",
    "doctor": "node scripts/doctor.mjs",
    "verify:skills": "node scripts/verify-skills.mjs",
    "format": "prettier --write \"apps/**/*.{ts,tsx,cjs,css}\" \"packages/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.mjs\" vite.config.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "docx": "9.5.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "44.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
