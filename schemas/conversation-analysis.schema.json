{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectId",
    "projectRevision",
    "summary",
    "messageDecisions",
    "proposals"
  ],
  "properties": {
    "messageDecisions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["messageId", "outcome", "requestKeys", "reason"],
        "properties": {
          "messageId": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["demand", "resolved", "no_action", "context", "review"]},
          "requestKeys": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "projectRevision": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "string",
      "maxLength": 10000
    },
    "proposals": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "expectedTaskVersion",
          "requestKey",
          "title",
          "description",
          "kind",
          "priority",
          "dueAt",
          "evidenceIds",
          "needsReview"
        ],
        "properties": {
          "operation": {"enum": ["upsert", "complete", "cancel"]},
          "expectedTaskVersion": {"type": ["integer", "null"], "minimum": 1},
          "requestKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "kind": {
            "enum": [
              "copy",
              "design",
              "page",
              "strategy",
              "service",
              "traffic"
            ]
          },
          "priority": {
            "enum": [
              "low",
              "normal",
              "high",
              "urgent"
            ]
          },
          "dueAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "needsReview": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
