    "projectRevision",
    "status",
    "missingInformation",
    "evidenceIds",
    "optionSetId",
    "optionSetVersion",
    "selectedOptionId",
    "participantId",
    "reason"
  ],
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "projectRevision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "ready",
        "blocked",
        "needs_review"
      ]
    },
    "missingInformation": {
