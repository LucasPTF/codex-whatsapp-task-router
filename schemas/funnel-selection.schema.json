      "items": {
        "type": "string"
      }
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "optionSetId": {
      "type": [
        "string",
        "null"
      ]
    },
    "optionSetVersion": {
      "type": [
        "integer",
        "null"
      ]
    },
    "selectedOptionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "participantId": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": "string"
    }
  }
}
