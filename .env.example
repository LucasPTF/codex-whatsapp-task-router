# Demonstração é o modo seguro padrão.
APP_MODE=demo
PORT=4318
DATA_DIR=./var
# Produção local inicial: defina APP_MODE=production e, somente na primeira
# inicialização, forneça as três variáveis abaixo pelo ambiente do processo.
# Remova-as do ambiente imediatamente depois que o administrador for criado.
# BOOTSTRAP_ADMIN_USERNAME=administrador
# BOOTSTRAP_ADMIN_NAME=Administrador
# BOOTSTRAP_ADMIN_PASSWORD=use-uma-senha-longa-e-unica
# O analisador é opt-in e exige login ChatGPT existente no Codex deste host.
# CODEX_ANALYZER_ENABLED=true
# CODEX_ANALYZER_MODEL=gpt-5.6-sol
# CODEX_ANALYZER_REASONING_EFFORT=high
# Use medium para comparar com a avaliação scripts/evaluate-conversation-analysis.ts.
# CODEX_ANALYZER_TIMEOUT_MS=180000
# CODEX_EXECUTABLE=C:\Users\seu-usuario\AppData\Local\Programs\OpenAI\Codex\bin\codex.exe
# Conector gratuito não oficial, somente leitura. A primeira ativação exibe
# um QR Code protegido dentro do painel; não abre nem controla navegador.
# WHATSAPP_CONNECTOR_ENABLED=true
# WHATSAPP_ACCOUNT_ID=primary
# O servidor continua restrito a 127.0.0.1. LAN/TLS pertence ao P1-03.
